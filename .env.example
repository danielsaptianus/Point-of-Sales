# Application
NODE_ENV=development
PORT=3000
APP_NAME=my-app

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/__DATABASE_NAME__?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# CORS
CORS_ORIGIN=http://localhost:3001

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# iPaymu Payment Gateway
IPAYMU_VA=117900XXXXXXXXXX
IPAYMU_API_KEY=sandbox-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
IPAYMU_SANDBOX=true
IPAYMU_RETURN_URL=http://localhost:3000/v1/sales/payment/return
IPAYMU_CANCEL_URL=http://localhost:3000/v1/sales/payment/cancel
IPAYMU_NOTIFY_URL=http://yourdomain.com/v1/sales/webhook
