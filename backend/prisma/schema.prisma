generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 1. AUTHENTICATION & RBAC SCHEMA (Milestone 1)
// ============================================

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  last_password_reset DateTime? 
  last_login          DateTime?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relasi One-to-One ke Employee
  employee            Employee?
  
  // Transactions recorded by this user (cashier)
  transactions        Transaction[]

  @@map("users")
}

model Position {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  employees            Employee[]
  position_permissions PositionPermission[]

  @@map("positions")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  resource    String
  action      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  position_permissions PositionPermission[]

  @@map("permissions")
}

model PositionPermission {
  id            Int      @id @default(autoincrement())
  position_id   Int
  permission_id Int
  created_at    DateTime @default(now())

  position   Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@map("position_permissions")
}


model Employee {
  id              Int       @id @default(autoincrement())
  employee_number String    @unique // NIP
  first_name      String
  last_name       String
  gender          String
  phone           String?
  address         String?
  hire_date       DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  user_id         Int?      @unique
  user            User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  position_id     Int
  position        Position  @relation(fields: [position_id], references: [id])

  @@map("employees")
}

// ============================================
// 3. PRODUCT & INVENTORY SCHEMA (Milestone 3)
// ============================================

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String    @unique
  description String?
  price       Float
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  category_id Int
  category    Category  @relation(fields: [category_id], references: [id], onDelete: Restrict)
  
  stocks      Stock[]
  transaction_items TransactionItem[]

  @@map("products")
}

model Stock {
  id             Int       @id @default(autoincrement())
  quantity       Int
  type           String    // "IN", "OUT", "ADJUSTMENT"
  notes          String?
  status         String    @default("SUCCESS") // "SUCCESS", "PENDING", "FAILED"
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  product_id     Int
  product        Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  // Linkage to transaction if stock change is caused by a sale
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@map("stocks")
}

// ============================================
// 4. SALES & TRANSACTION SCHEMA (Milestone 4)
// ============================================

model Transaction {
  id             Int       @id @default(autoincrement())
  invoice_number String    @unique // e.g. "INV-20260720-XXXX"
  subtotal       Float     // Total before discount & tax
  tax            Float     @default(0)
  discount       Float     @default(0)
  total          Float     // Net total to pay
  status         String    @default("PENDING") // "PENDING", "PAID", "CANCELLED", "FAILED"
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  // Relations
  user_id        Int       // Cashier user ID
  user           User      @relation(fields: [user_id], references: [id])
  
  transaction_items TransactionItem[]
  payment           Payment?
  stocks            Stock[] // Records stock reduction for this transaction

  @@map("transactions")
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  quantity       Int
  price          Float       // Price at checkout time
  subtotal       Float       // quantity * price
  
  // Relations
  transaction_id Int
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product_id     Int
  product        Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("transaction_items")
}

model Payment {
  id              Int       @id @default(autoincrement())
  payment_method  String    // "CASH", "IPAYMU_REDIRECT"
  payment_gateway String?   // "IPAYMU"
  reference_id    String?   @unique // SessionID or Transaction ID from iPaymu
  status          String    @default("PENDING") // "PENDING", "PAID", "EXPIRED", "FAILED"
  checkout_url    String?   // Redirect url for iPaymu
  paid_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  transaction_id  Int       @unique
  transaction     Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@map("payments")
}
