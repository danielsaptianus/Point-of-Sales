generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 1. AUTHENTICATION & RBAC SCHEMA (Milestone 1)
// ============================================

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  last_password_reset DateTime?
  last_login          DateTime?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relasi One-to-One ke Employee
  employee Employee?

  // Transactions recorded by this user (cashier)
  transactions Transaction[]
  
  // Shifts
  shifts Shift[]

  @@map("users")
}

model Position {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  employees            Employee[]
  position_permissions PositionPermission[]

  @@map("positions")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  resource    String
  action      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  position_permissions PositionPermission[]

  @@map("permissions")
}

model PositionPermission {
  id            Int      @id @default(autoincrement())
  position_id   Int
  permission_id Int
  created_at    DateTime @default(now())

  position   Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@map("position_permissions")
}

model Employee {
  id              Int    @id @default(autoincrement())
  employee_number String @unique

  // Personal Information
  first_name     String
  last_name      String?
  gender         String
  birth_date     DateTime?
  marital_status String? // SINGLE, MARRIED, DIVORCED, WIDOWED

  // Contact Information
  email   String?
  phone   String?
  address String?

  // Employment Information
  hire_date        DateTime?
  termination_date DateTime?
  employment_type  String? // FULL_TIME, PART_TIME, CONTRACT, INTERN
  salary           Decimal?  @db.Decimal(15, 2)

  // Bank Information
  bank_name           String?
  bank_account_number String?
  bank_account_name   String?

  // Status & Audit
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Authentication
  user_id Int?  @unique
  user    User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Position
  position_id Int
  position    Position @relation(fields: [position_id], references: [id])

  @@map("employees")
}

// ============================================
// 3. PRODUCT & INVENTORY SCHEMA (Milestone 3)
// ============================================

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  products Product[]

  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String    @unique
  description String?
  price       Float
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  category_id Int
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  stocks            Stock[]
  transaction_items TransactionItem[]
  inventory_batches InventoryBatch[]

  @@map("products")
}

model Stock {
  id         Int      @id @default(autoincrement())
  quantity   Int
  type       String // "IN", "OUT", "ADJUSTMENT"
  notes      String?
  status     String   @default("SUCCESS") // "SUCCESS", "PENDING", "FAILED"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product_id Int
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // Linkage to transaction if stock change is caused by a sale
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@map("stocks")
}

// ============================================
// 4. SALES, SHIFT & TRANSACTION SCHEMA (Milestone 4)
// ============================================

model Shift {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  start_time           DateTime  @default(now())
  end_time             DateTime?
  starting_cash        Float
  expected_ending_cash Float?
  actual_ending_cash   Float?
  difference           Float?
  status               String    @default("OPEN") // "OPEN", "CLOSED"
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user         User          @relation(fields: [user_id], references: [id])
  transactions Transaction[]

  @@map("shifts")
}

model Transaction {
  id             Int       @id @default(autoincrement())
  invoice_number String    @unique // e.g. "INV-20260720-XXXX"
  subtotal       Float // Total before discount & tax
  tax            Float     @default(0)
  discount       Float     @default(0)
  total          Float // Net total to pay
  status         String    @default("PENDING") // "PENDING", "PAID", "CANCELLED", "FAILED"
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  // Relations
  user_id Int // Cashier user ID
  user    User @relation(fields: [user_id], references: [id])

  shift_id Int? // Link to the active shift
  shift    Shift? @relation(fields: [shift_id], references: [id])

  applied_voucher_id Int? // Track voucher ID applied (especially for PENDING online payments)

  transaction_items    TransactionItem[]
  payment              Payment?
  stocks               Stock[] // Records stock reduction for this transaction
  transaction_vouchers TransactionVoucher[]

  @@map("transactions")
}

model TransactionItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  price    Float // Price at checkout time
  subtotal Float // quantity * price

  // Relations
  transaction_id Int
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product_id     Int
  product        Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)

  transaction_item_batches TransactionItemBatch[]

  @@map("transaction_items")
}

model InventoryBatch {
  id                 Int      @id @default(autoincrement())
  received_date      DateTime @default(now())
  cost_per_unit      Float    
  initial_quantity   Int      
  remaining_quantity Int      
  
  product_id         Int
  product            Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  transaction_item_batches TransactionItemBatch[]

  @@map("inventory_batches")
}

model TransactionItemBatch {
  id                  Int      @id @default(autoincrement())
  quantity_deducted   Int
  
  transaction_item_id Int
  transaction_item    TransactionItem @relation(fields: [transaction_item_id], references: [id], onDelete: Cascade)

  inventory_batch_id  Int
  inventory_batch     InventoryBatch  @relation(fields: [inventory_batch_id], references: [id], onDelete: Cascade)

  @@map("transaction_item_batches")
}

model Payment {
  id              Int       @id @default(autoincrement())
  payment_method  String // "CASH", "IPAYMU_REDIRECT"
  payment_gateway String? // "IPAYMU"
  reference_id    String?   @unique // SessionID or Transaction ID from iPaymu
  status          String    @default("PENDING") // "PENDING", "PAID", "EXPIRED", "FAILED"
  checkout_url    String? // Redirect url for iPaymu
  paid_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  transaction_id Int         @unique
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============================================
// 5. VOUCHER SCHEMA (Milestone 5)
// ============================================

model Voucher {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  name            String
  description     String?
  discount_type   String // "PERCENTAGE" or "FIXED"
  discount_value  Decimal   @db.Decimal(15, 2)
  max_discount    Decimal?  @db.Decimal(15, 2)
  min_transaction Decimal?  @db.Decimal(15, 2)
  usage_limit     Int?
  used_count      Int       @default(0)
  start_date      DateTime
  end_date        DateTime
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  transaction_vouchers TransactionVoucher[]

  @@map("vouchers")
}

model TransactionVoucher {
  id              Int      @id @default(autoincrement())
  transaction_id  Int
  voucher_id      Int
  discount_amount Decimal  @db.Decimal(15, 2)
  created_at      DateTime @default(now())

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  voucher     Voucher     @relation(fields: [voucher_id], references: [id], onDelete: Restrict)

  @@unique([transaction_id, voucher_id])
  @@map("transaction_vouchers")
}
